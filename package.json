{
  "name": "mathslice",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "astro": "astro",
    "build": "astro build",
    "check": "astro check",
    "dev": "astro dev",
    "engine:bench": "cd engine && cargo bench -p ms-rules --bench matcher",
    "engine:browser": "node engine/scripts/browser-check.mjs",
    "engine:build": "cd engine/crates/ms-wasm && wasm-pack build --target web --out-dir ../../../src/lib/engine/pkg --out-name ms_engine",
    "engine:coverage": "cd engine && cargo run -q -p ms-cli -- coverage",
    "engine:gates": "cd engine && cargo clippy --workspace --all-targets && cargo deny check && ./scripts/check-boundary.sh && cargo run -q -p ms-cli -- tree --check",
    "engine:lean": "cd engine && ./scripts/check-soundness.sh && cd lean && lake build",
    "engine:size": "twiggy top -n 15 src/lib/engine/pkg/ms_engine_bg.wasm",
    "engine:test": "cd engine && cargo nextest run --workspace",
    "engine:tree": "cd engine && cargo run -q -p ms-cli -- tree",
    "engine:tree:check": "cd engine && cargo run -q -p ms-cli -- tree --check",
    "preview": "astro preview",
    "test": "vitest run",
    "test:build": "vitest run --config vitest.build.config.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.3",
    "@astrojs/react": "^6.0.1",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@xyflow/react": "^12.11.2",
    "astro": "^7.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "katex": "^0.16.47",
    "mafs": "^0.21.0",
    "mathlive": "^0.110.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
