---
interface Props {
  kicker?: string;
  title: string;
  blurb: string;
}
const { kicker, title, blurb } = Astro.props;
---

<section class="pt-10 sm:pt-16">
  {kicker && (
    <p class="font-mono text-xs uppercase tracking-[0.22em] text-ink-muted">{kicker}</p>
  )}
  <h1 class="mt-3 text-balance text-4xl font-semibold leading-[1.05] text-ink sm:text-6xl">
    {title}
  </h1>
  <p class="mt-5 max-w-xl text-lg leading-relaxed text-ink-muted">{blurb}</p>
  <slot />
</section>
