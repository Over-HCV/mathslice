---
/*
  /motor — the index: the engine's coverage of the reference capability inventory,
  category by category.

  Both locales render this same component; the chrome comes from i18n and the capability
  names come from engine/tree/, in English, because they are the id that joins the corpus
  to engine/docs/.
*/
import Base from "@/layouts/Base.astro";
import CoverageBar from "@/components/engine-tree/CoverageBar.astro";
import { readIndex } from "@/lib/engineTree.server";
import { t, sectionPath, DEFAULT_LOCALE, type Locale } from "@/i18n";

const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const strings = t(locale);
const words = strings.engine;

const index = readIndex();
const base = sectionPath("engine", locale);

const real = index.categories.filter((category) => !category.reindexed);
const reindexed = index.categories.filter((category) => category.reindexed);
---

<Base
  section="engine"
  title={`${strings.sections.engine.title} · ${strings.brand}`}
  description={strings.sections.engine.blurb}
>
  <header class="mx-auto max-w-3xl">
    <h1 class="text-balance text-4xl font-semibold leading-[1.08] text-ink sm:text-5xl">
      {strings.sections.engine.title}
    </h1>
    <p class="mt-4 text-lg text-ink-muted">{strings.sections.engine.blurb}</p>

    <div class="mt-8 rounded-[var(--radius-md)] border border-border bg-surface px-6 py-5">
      <CoverageBar
        covered={index.totals.covered}
        leaves={index.totals.leaves}
        percent={index.totals.percent}
        label={words.coverage}
        ofTotal={words.ofTotal}
        capabilities={words.capabilities}
        big
      />
    </div>
  </header>

  <ul class="mx-auto mt-8 max-w-3xl space-y-2">
    {
      real.map((category) => (
        <li>
          <a
            href={`${base}/${category.slug}`}
            class="block rounded-[var(--radius-md)] border border-border bg-surface px-6 py-4 transition-colors hover:border-primary"
          >
            <p class="mb-2 font-semibold text-ink">{category.title}</p>
            <CoverageBar
              covered={category.covered}
              leaves={category.leaves}
              percent={category.percent}
              label={words.coverage}
              ofTotal={words.ofTotal}
              capabilities={words.capabilities}
            />
          </a>
        </li>
      ))
    }
  </ul>

  {
    reindexed.length > 0 && (
      <section class="mx-auto mt-10 max-w-3xl">
        <p class="text-sm text-ink-muted">{words.reindexedNote}</p>
        <ul class="mt-3 space-y-2">
          {reindexed.map((category) => (
            <li>
              <a
                href={`${base}/${category.slug}`}
                class="block rounded-[var(--radius-md)] border border-dashed border-border px-6 py-4 transition-colors hover:border-primary"
              >
                <p class="mb-2 font-semibold text-ink-muted">{category.title}</p>
                <CoverageBar
                  covered={category.covered}
                  leaves={category.leaves}
                  percent={category.percent}
                  label={words.coverage}
                  ofTotal={words.ofTotal}
                  capabilities={words.capabilities}
                />
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>
